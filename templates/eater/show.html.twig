{% extends 'base.html.twig' %}

{% block title %}{{ eater.name }} · {{ evening.name }} · Slice{% endblock %}

{% block body %}
    <header class="mb-4">
        <h1 class="h3 mb-1">{{ evening.name }}</h1>
        <p class="text-body-secondary mb-0">
            {{ evening.date|date }}{% if evening.pizzeria %} · {{ evening.pizzeria }}{% endif %}
        </p>
        <p class="fs-5 fw-semibold mb-0">{{ eater.name }}</p>
    </header>
    <twig:PizzaOrder eater="{{ eater }}" />
{% endblock %}
