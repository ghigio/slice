<section {{ attributes }} data-poll="delay(15000)|$render">
    {% set editable = this.canEdit %}
    {% set list_id = 'eater-' ~ eater.id %}
    {% set bill = this.bill %}
    {% if bill %}
        {{ include('components/_eater_bill.html.twig', {bill: bill, eater: eater, evening: eater.evening}) }}
    {% else %}

    {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
    {% if notice %}<div class="alert alert-success" role="status">{{ notice }}</div>{% endif %}

    {% if not editable %}
        <div class="alert alert-secondary" role="status">
            {{ asOrganizer ? 'Serata archiviata: sola lettura.' : "Ordini chiusi dall'organizzatore." }}
        </div>
    {% else %}
        {# Il prezzo lo inserisce solo l'organizzatore: chi ordina di solito non lo conosce. #}
        <form class="card card-body mb-4" data-action="live#action:prevent" data-live-action-param="add"
              {% if asOrganizer %}{{ stimulus_controller('pizza-price', {prices: this.suggestedPrices}) }}{% endif %}>
            <div class="mb-2">
                <label for="{{ list_id }}-person" class="form-label">Persona</label>
                <input id="{{ list_id }}-person" type="text" class="form-control form-control-lg" maxlength="60" autocomplete="off"
                       list="{{ list_id }}-persons" data-model="norender|person" value="{{ person }}" required>
            </div>
            <div class="{{ asOrganizer ? 'mb-2' : 'mb-3' }}">
                <label for="{{ list_id }}-pizza" class="form-label">Pizza</label>
                <input id="{{ list_id }}-pizza" type="text" class="form-control form-control-lg" maxlength="80" autocomplete="off"
                       list="{{ list_id }}-pizzas" data-model="norender|pizzaName" value="{{ pizzaName }}" required
                       {% if asOrganizer %}{{ stimulus_target('pizza-price', 'name') }} data-action="input->pizza-price#suggest"{% endif %}>
            </div>
            {% if asOrganizer %}
            <div class="mb-3">
                <label for="{{ list_id }}-price" class="form-label">Prezzo (€), facoltativo</label>
                <input id="{{ list_id }}-price" type="text" inputmode="decimal" class="form-control form-control-lg" placeholder="7,50"
                       aria-describedby="{{ list_id }}-price-help"
                       data-model="norender|price" value="{{ price }}" {{ stimulus_target('pizza-price', 'price') }}>
                <div id="{{ list_id }}-price-help" class="form-text">Se non lo conosci lascialo vuoto e completalo dal riquadro «Pizze senza prezzo».</div>
            </div>
            {% endif %}
            <button type="submit" class="btn btn-primary btn-lg w-100">Aggiungi pizza</button>
        </form>
    {% endif %}

    {# Solo nomi e prezzi delle pizze della serata, nessun dato personale di altri gruppi. #}
    <datalist id="{{ list_id }}-pizzas" data-pizza-suggestions>
        {% for suggestion in this.pizzaSuggestions %}<option value="{{ suggestion.name }}"></option>{% endfor %}
    </datalist>
    <datalist id="{{ list_id }}-persons" data-person-suggestions>
        {% for name in this.personSuggestions %}<option value="{{ name }}"></option>{% endfor %}
    </datalist>

    {% set groups = this.byPerson %}
    {% if groups is empty %}
        <p class="text-body-secondary">Nessuna pizza inserita.</p>
    {% endif %}

    <div {{ stimulus_controller('confirm') }}>
        {% for person_name, group in groups %}
            <div class="mb-3" data-person-block>
                <div class="d-flex justify-content-between align-items-baseline border-bottom mb-1">
                    <h3 class="h6 mb-1" data-person-name>{{ person_name }}</h3>
                    {% if asOrganizer %}
                    <span class="fw-semibold" data-person-total>
                        {%- if group.missing == group.pizzas|length -%}
                            <span class="fw-normal fst-italic text-body-secondary">da definire</span>
                        {%- else -%}
                            {{ group.totalCents|money }}{% if group.missing > 0 %} <span class="fw-normal small text-body-secondary">+ {{ group.missing }} da definire</span>{% endif %}
                        {%- endif -%}
                    </span>
                    {% else %}
                    {% set count = group.pizzas|length %}
                    <span class="text-body-secondary small">{{ count }} {{ count == 1 ? 'pizza' : 'pizze' }}</span>
                    {% endif %}
                </div>
                <ul class="list-unstyled mb-0">
                    {% for pizza in group.pizzas %}
                        <li class="py-1">
                            {% if editable and editingId == pizza.id %}
                                <form class="card card-body" data-action="live#action:prevent" data-live-action-param="save">
                                    <label class="form-label" for="edit-person-{{ pizza.id }}">Persona</label>
                                    <input id="edit-person-{{ pizza.id }}" type="text" class="form-control mb-2" maxlength="60" list="{{ list_id }}-persons" data-model="norender|editPerson" value="{{ editPerson }}">
                                    <label class="form-label" for="edit-pizza-{{ pizza.id }}">Pizza</label>
                                    <input id="edit-pizza-{{ pizza.id }}" type="text" class="form-control mb-2" maxlength="80" list="{{ list_id }}-pizzas" data-model="norender|editPizzaName" value="{{ editPizzaName }}">
                                    {% if asOrganizer %}
                                    <label class="form-label" for="edit-price-{{ pizza.id }}">Prezzo (€), facoltativo</label>
                                    <input id="edit-price-{{ pizza.id }}" type="text" inputmode="decimal" class="form-control mb-2" data-model="norender|editPrice" value="{{ editPrice }}">
                                    {% endif %}
                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-primary">Salva</button>
                                        <button type="button" class="btn btn-link" data-action="live#action" data-live-action-param="cancelEdit">Annulla</button>
                                    </div>
                                </form>
                            {% else %}
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="flex-grow-1">{{ pizza.pizzaName }}</span>
                                    {% if asOrganizer %}
                                        {% if pizza.hasPrice %}<span>{{ pizza.priceCents|money }}</span>{% else %}<span class="text-body-secondary fst-italic">Prezzo da definire</span>{% endif %}
                                    {% endif %}
                                    {% if editable %}
                                        <button type="button" class="btn btn-outline-secondary" data-action="live#action"
                                                data-live-action-param="startEdit" data-live-pizza-id-param="{{ pizza.id }}">Modifica</button>
                                        <button type="button" class="btn btn-outline-danger" data-action="confirm#ask live#action"
                                                data-live-action-param="delete" data-live-pizza-id-param="{{ pizza.id }}"
                                                data-confirm-message-param="Eliminare {{ pizza.pizzaName }} di {{ pizza.person }}?">Elimina</button>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    </div>

    {% if asOrganizer %}
    <div class="border-top pt-2" data-eater-total>
        <p class="d-flex justify-content-between fs-5 mb-0">
            <span>Totale del gruppo</span><strong>{{ this.totalCents|money }}</strong>
        </p>
        {% set missing = this.missingPrices %}
        {% if missing > 0 %}
            <p class="small text-body-secondary mb-0">Più {{ missing }} {{ missing == 1 ? 'pizza senza prezzo' : 'pizze senza prezzo' }}, da completare.</p>
        {% endif %}
    </div>
    {% endif %}
    {% endif %}
</section>
